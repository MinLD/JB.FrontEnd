# Copy this template to .env or .env.local (both are ignored by Git).
# DO NOT place actual secrets or private tokens in this example file.

NEXT_TELEMETRY_DISABLED=1

# Backend URL used only by the Next.js server; browser requests stay same-origin.
JOBBOD_API_URL=https://api.jobbod.net

# Google Analytics 4 Measurement ID (format: G-...)
JOBBOD_GA_MEASUREMENT_ID=

# Google Search Console Verification token (optional)
JOBBOD_GOOGLE_SITE_VERIFICATION=

# Optional Firebase integration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
